{
  "services": {
    "backend": {
      "root": "backend",
      "framework": "express"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/auth/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/membros/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/membros",
      "destination": { "service": "backend" }
    },
    {
      "source": "/contas/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/contas",
      "destination": { "service": "backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}